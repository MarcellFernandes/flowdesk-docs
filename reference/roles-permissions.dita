<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="roles-permissions">
  <title>Roles and Permissions Reference</title>
  <refbody>
    <section>
      <title>Access Control Overview</title>
      <p>
        FlowDesk enforces role-based permissions to maintain operational integrity, accountability, and security. Each role is granted capabilities aligned with its service responsibilities.
      </p>
    </section>
    <section>
      <title>Permissions Matrix</title>
      <table>
        <tgroup cols="4">
          <thead>
            <row>
              <entry>Capability</entry>
              <entry>User</entry>
              <entry>Technician</entry>
              <entry>Manager</entry>
            </row>
          </thead>
          <tbody>
            <row>
              <entry>Create tickets</entry>
              <entry>Yes</entry>
              <entry>Yes</entry>
              <entry>Yes</entry>
            </row>
            <row>
              <entry>View personal tickets</entry>
              <entry>Yes</entry>
              <entry>Yes</entry>
              <entry>Yes</entry>
            </row>
            <row>
              <entry>View assigned tickets</entry>
              <entry>No</entry>
              <entry>Yes</entry>
              <entry>Yes</entry>
            </row>
            <row>
              <entry>Close tickets</entry>
              <entry>No</entry>
              <entry>Assigned only</entry>
              <entry>All tickets</entry>
            </row>
            <row>
              <entry>Modify ticket details</entry>
              <entry>No</entry>
              <entry>Assigned only</entry>
              <entry>All tickets</entry>
            </row>
            <row>
              <entry>Contribute to knowledge base</entry>
              <entry>No</entry>
              <entry>Yes</entry>
              <entry>Yes</entry>
            </row>
            <row>
              <entry>Manage knowledge base</entry>
              <entry>No</entry>
              <entry>Limited</entry>
              <entry>Full control</entry>
            </row>
            <row>
              <entry>Access operational analytics</entry>
              <entry>No</entry>
              <entry>Limited</entry>
              <entry>Yes</entry>
            </row>
          </tbody>
        </tgroup>
      </table>
    </section>
    <section>
      <title>Governance Considerations</title>
      <p>
        Permissions are enforced automatically to prevent unauthorized actions and preserve auditability. Organizations may refine role policies according to internal governance requirements.
      </p>
    </section>
  </refbody>
</reference>
